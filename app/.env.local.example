# RPC endpoint override. Defaults to public devnet if unset.
# For better reliability, set NEXT_PUBLIC_RPC_URL to a Helius/Triton/QuickNode devnet endpoint.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Faucet keypair (base58-encoded private key). Used by /api/faucet only.
# Generate with: solana-keygen new --no-bip39-passphrase --outfile faucet.json
# Then: cat faucet.json | jq -c | base58 ... (see scripts/encode-keypair.ts if needed)
FAUCET_KEYPAIR=
